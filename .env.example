# ParkPro API configuration (copy to .env)

# Port for the Express server (the Vite dev server proxies /api here)
PORT=4000

# Required when NODE_ENV=production: a random string of at least 32 characters.
# The server refuses to start in production without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# SQLite database file (defaults to ./data/parkpro.db)
# DB_PATH=./data/parkpro.db

# One-tap demo accounts with published credentials.
# Default: enabled in development, DISABLED in production unless set to true.
# DEMO_LOGIN=true

# Initial passwords for the seeded owner/staff accounts (used only when the database is empty).
# In production, if unset, a random password is generated and printed once at startup.
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=

# WhatsApp Cloud API (Meta) — enables automatic pass-expiry reminders.
# Create an approved template with 4 body variables in this order:
#   {{1}} customer name, {{2}} vehicle number, {{3}} site name, {{4}} expiry date
# Then put the template name and language code on Settings → WhatsApp reminders.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Optional: lets an external cron call POST /api/reminders/cron with the x-cron-key header
# (useful when the host sleeps and the in-process timer cannot run).
# REMINDER_CRON_SECRET=
